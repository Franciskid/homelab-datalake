# Copy to .env. Never commit .env -- see .gitignore.

# --- PII boundary -------------------------------------------------------------
# Salt for hashing client addresses. Generate once: openssl rand -hex 32
# Rotating it breaks continuity in visitor counts, which is correct behaviour but
# means the change should be deliberate and dated. See README.
CLIENT_IP_HASH_SALT=change-me-openssl-rand-hex-32

# --- MinIO --------------------------------------------------------------------
DATALAKE_S3_ENDPOINT=https://s3.homelab.example.test
DATALAKE_S3_BUCKET=datalake
DATALAKE_S3_ACCESS_KEY_ID=
DATALAKE_S3_SECRET_ACCESS_KEY=
DATALAKE_S3_REGION=us-east-1
# The second bucket the raw layer is mirrored into every night by the lake_backup
# asset. Same MinIO, different bucket: it protects against a delete, an overwrite and
# a dropped bucket, not against losing the machine. Created on the first run.
DATALAKE_BACKUP_BUCKET=datalake-backup
# How long an object that has left raw/ is kept in the mirror. Ninety days, because
# the failure this guards against is a deletion nobody noticed, and nobody notices in
# a week. 0 keeps orphans for ever.
DATALAKE_BACKUP_ORPHAN_DAYS=90

# --- Log sources --------------------------------------------------------------
# Which NPM instances to ingest, comma-separated. Each one needs its log directory
# mounted read-only and a matching NPM_LOG_DIR_<HOST> below; an instance listed here
# without a mount fails its partition every night.
NPM_HOSTS=primary
NPM_LOG_DIR_PRIMARY=/logs/primary

# --- Optional geo enrichment --------------------------------------------------
# Path to a MaxMind GeoLite2-City.mmdb / GeoLite2-ASN.mmdb pair. Absent = null geo columns.
GEOIP_CITY_DB=
GEOIP_ASN_DB=

# --- Warehouse ----------------------------------------------------------------
DUCKDB_PATH=/warehouse/datalake.duckdb
DUCKDB_SERVING_PATH=/warehouse/serving.duckdb

# --- MCP server ---------------------------------------------------------------
# The Keycloak realm the bearer tokens are issued by. Leave empty and the server
# refuses to start over HTTP: an unauthenticated analytics endpoint is a worse
# outcome than one that is down, because nothing about it looks wrong.
MCP_OIDC_ISSUER=https://auth.example.test/realms/homelab
# The confidential client whose service account callers use. Authorisation is the
# datalake:query CLIENT role on this client -- a realm role could be granted to
# something unrelated by accident.
MCP_OIDC_CLIENT_ID=datalake-mcp
DATALAKE_EXPORT_DIR=/exports

# --- Workbench API ------------------------------------------------------------
# The catalogue and the SQL endpoint behind Explore > Data in ai.example.test. It
# verifies the same Keycloak tokens as the MCP server and shares its two settings
# above, so there is one realm and one role to revoke rather than two.
DATALAKE_API_PORT=3444
# Say yes only for a local sandbox holding no real data. It lets the API serve the
# whole lake to anyone who can reach the port.
DATALAKE_API_ALLOW_ANONYMOUS=
# The write switch, at the deployment level. Leave empty until the lake has bucket
# versioning, a daily copy of raw/, and a restore somebody has actually run: the raw
# layer is not rebuildable, because the proxy logs rotate off the disk and the camera
# serves only a recent window. With this empty, a caller asking to write is refused.
DATALAKE_API_ALLOW_WRITES=
# Where every statement is written down -- who, what, when, how long, how many rows,
# and whether the switch was off. Its own volume, so the record survives what it
# records. Rotates at 32 MB and keeps three previous generations.
DATALAKE_AUDIT_PATH=/audit/queries.jsonl
# What one query session may use before DuckDB refuses rather than taking the host
# down with it. The 30-second deadline is the primary bound; this catches the query
# that is fast and enormous.
DATALAKE_API_MEMORY_LIMIT=2GB

# --- Sources reached over HTTP ------------------------------------------------
# The camera export, at the other site. Reached by its public URL with a Keycloak
# token -- the two sites are never joined at the host level.
CAMERA_EXPORT_URL=
CAMERA_OIDC_TOKEN_URL=https://auth.example.test/realms/homelab/protocol/openid-connect/token
CAMERA_OIDC_CLIENT_ID=datalake-exporter
CAMERA_OIDC_CLIENT_SECRET=

# The LiteLLM spend ledger. A read-only Postgres role granted SELECT on exactly one
# table -- see the deployment notes in the README.
LITELLM_PG_HOST=
LITELLM_PG_PORT=5432
LITELLM_PG_DB=litellm
LITELLM_PG_USER=datalake_ro
LITELLM_PG_PASSWORD=

# Dagster's own run/event-log/schedule storage -- see dagster.yaml. A dedicated
# read-write role on its own database, NOT the datalake_ro role above: that one is
# read-only by design, and Dagster needs to write. See docs/ for the one-time
# provisioning SQL and the reasoning for moving off SQLite.
#
# That role carries a hard CONNECTION LIMIT of 40 in Postgres, because this server
# is shared: max_connections is 100 and keycloak, banking-tracker, ai_platform and
# litellm all draw on it. If Dagster ever reports being unable to connect, check
# that limit before assuming the credentials are wrong.
DAGSTER_PG_HOST=
DAGSTER_PG_PORT=5432
DAGSTER_PG_DB=dagster
DAGSTER_PG_USER=dagster_rw
DAGSTER_PG_PASSWORD=

# Jellyfin. An API key scoped to this pipeline, revocable on its own.
JELLYFIN_URL=
JELLYFIN_API_KEY=

# TMDB, for library enrichment: budget, revenue, original language, vote counts.
# Free, but it needs an account (themoviedb.org -> Settings -> API). Optional in the
# same way geo is: with no key the enrichment columns are null and everything else
# runs, so CI never needs a credential.
TMDB_API_KEY=

# --- Keycloak in front of the Dagster UI --------------------------------------
OAUTH2_PROXY_CLIENT_ID=datalake-web
OAUTH2_PROXY_CLIENT_SECRET=
# openssl rand -hex 16 -- NOT rand -base64 32, which yields 44 characters and
# oauth2-proxy only base64-decodes the URL-safe alphabet.
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_OIDC_ISSUER_URL=https://auth.example.test/realms/homelab
OAUTH2_PROXY_REDIRECT_URL=https://data.example.test/oauth2/callback
# Authorisation is the role, not the address.
OAUTH2_PROXY_ALLOWED_ROLES=datalake-user
