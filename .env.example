# Copy to .env. Never commit .env -- see .gitignore.

# --- PII boundary -------------------------------------------------------------
# Salt for hashing client addresses. Generate once: openssl rand -hex 32
# Rotating it breaks continuity in visitor counts, which is correct behaviour but
# means the change should be deliberate and dated. See README.
CLIENT_IP_HASH_SALT=change-me-openssl-rand-hex-32

# --- MinIO --------------------------------------------------------------------
DATALAKE_S3_ENDPOINT=https://s3.homelab.example.test
DATALAKE_S3_BUCKET=datalake
DATALAKE_S3_ACCESS_KEY_ID=
DATALAKE_S3_SECRET_ACCESS_KEY=
DATALAKE_S3_REGION=us-east-1

# --- Log sources --------------------------------------------------------------
# Which NPM instances to ingest, comma-separated. Each one needs its log directory
# mounted read-only and a matching NPM_LOG_DIR_<HOST> below; an instance listed here
# without a mount fails its partition every night.
NPM_HOSTS=primary
NPM_LOG_DIR_PRIMARY=/logs/primary

# --- Optional geo enrichment --------------------------------------------------
# Path to a MaxMind GeoLite2-City.mmdb / GeoLite2-ASN.mmdb pair. Absent = null geo columns.
GEOIP_CITY_DB=
GEOIP_ASN_DB=

# --- Warehouse ----------------------------------------------------------------
DUCKDB_PATH=/warehouse/datalake.duckdb
DUCKDB_SERVING_PATH=/warehouse/serving.duckdb

# --- MCP server ---------------------------------------------------------------
# The Keycloak realm the bearer tokens are issued by. Leave empty and the server
# refuses to start over HTTP: an unauthenticated analytics endpoint is a worse
# outcome than one that is down, because nothing about it looks wrong.
MCP_OIDC_ISSUER=https://auth.example.test/realms/homelab
# The confidential client whose service account callers use. Authorisation is the
# datalake:query CLIENT role on this client -- a realm role could be granted to
# something unrelated by accident.
MCP_OIDC_CLIENT_ID=datalake-mcp
DATALAKE_EXPORT_DIR=/exports

# --- Sources reached over HTTP ------------------------------------------------
# The camera export, at the other site. Reached by its public URL with a Keycloak
# token -- the two sites are never joined at the host level.
CAMERA_EXPORT_URL=
CAMERA_OIDC_TOKEN_URL=https://auth.example.test/realms/homelab/protocol/openid-connect/token
CAMERA_OIDC_CLIENT_ID=datalake-exporter
CAMERA_OIDC_CLIENT_SECRET=

# The LiteLLM spend ledger. A read-only Postgres role granted SELECT on exactly one
# table -- see the deployment notes in the README.
LITELLM_PG_HOST=
LITELLM_PG_PORT=5432
LITELLM_PG_DB=litellm
LITELLM_PG_USER=datalake_ro
LITELLM_PG_PASSWORD=

# Jellyfin. An API key scoped to this pipeline, revocable on its own.
JELLYFIN_URL=
JELLYFIN_API_KEY=

# --- Keycloak in front of the Dagster UI --------------------------------------
OAUTH2_PROXY_CLIENT_ID=datalake-web
OAUTH2_PROXY_CLIENT_SECRET=
# openssl rand -hex 16 -- NOT rand -base64 32, which yields 44 characters and
# oauth2-proxy only base64-decodes the URL-safe alphabet.
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_OIDC_ISSUER_URL=https://auth.example.test/realms/homelab
OAUTH2_PROXY_REDIRECT_URL=https://data.example.test/oauth2/callback
# Authorisation is the role, not the address.
OAUTH2_PROXY_ALLOWED_ROLES=datalake-user
