# Copy to .env. Never commit .env -- see .gitignore.

# --- PII boundary -------------------------------------------------------------
# Salt for hashing client addresses. Generate once: openssl rand -hex 32
# Rotating it breaks continuity in visitor counts, which is correct behaviour but
# means the change should be deliberate and dated. See README.
CLIENT_IP_HASH_SALT=change-me-openssl-rand-hex-32

# --- MinIO --------------------------------------------------------------------
DATALAKE_S3_ENDPOINT=https://s3.homelab.example.test
DATALAKE_S3_BUCKET=datalake
DATALAKE_S3_ACCESS_KEY_ID=
DATALAKE_S3_SECRET_ACCESS_KEY=
DATALAKE_S3_REGION=us-east-1

# --- Log sources --------------------------------------------------------------
# Which NPM instances to ingest, comma-separated. Each one needs its log directory
# mounted read-only and a matching NPM_LOG_DIR_<HOST> below; an instance listed here
# without a mount fails its partition every night.
NPM_HOSTS=primary
NPM_LOG_DIR_PRIMARY=/logs/primary

# --- Optional geo enrichment --------------------------------------------------
# Path to a MaxMind GeoLite2-City.mmdb / GeoLite2-ASN.mmdb pair. Absent = null geo columns.
GEOIP_CITY_DB=
GEOIP_ASN_DB=

# --- Warehouse ----------------------------------------------------------------
DUCKDB_PATH=/warehouse/datalake.duckdb
