# --- Sources added 2026-09-15 -------------------------------------------------
# See docs/METRICS_STREAMING_PLAN.md. Everything below has a working default on primary;
# set a variable only to point somewhere else.
#
# Prometheus, streamed by the prometheus_stream sensor. The LAN address of its published
# port, which datalake-daemon can reach; http(s) only.
PROMETHEUS_URL=http://198.51.100.26:9090
# Host directories docker-compose.yml mounts read-only. Paths with spaces are fine.
HOST_LOG_MOUNT=/var/log
RADARR_CONFIG_DIR=/srv/media/Radarr/config
SONARR_CONFIG_DIR=/srv/media/Sonarr/config
JELLYSEERR_DB_DIR=/srv/media/Jellyseer/config/db
# Keycloak sign-in events. Unset, each KEYCLOAK_PG_* falls back to its LITELLM_PG_*
# counterpart: the same read-only datalake_ro role, granted SELECT on the event tables
# by infra/keycloak-datalake-grants.sql. Run scripts/setup-keycloak-events.sh once.
KEYCLOAK_PG_HOST=
KEYCLOAK_PG_USER=
KEYCLOAK_PG_PASSWORD=
KEYCLOAK_PG_DB=keycloak
