*.duckdb
*.duckdb.wal
warehouse/
target/
dbt_packages/
logs/

# Dagster local state
tmp*/
.dagster/
dagster_home/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# macOS
.DS_Store

# Lake and warehouse are build artefacts, rebuildable from the source logs
.lake/
seed/
.dagster_home/
dbt/target/
dbt/dbt_packages/
dbt/logs/
package-lock.yml
dbt/.user.yml
